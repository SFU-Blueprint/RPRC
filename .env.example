# Copy to .env.local. These Supabase values are the local stack's defaults (`npm run dev` starts it).
# If yours differ, copy them from `npx supabase status`. To point the app at the hosted dev project
# instead, replace them with that project's URL and keys. See DEVELOPMENT.md.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# The app's base URL: auth email links (signup confirmation, password reset) and Stripe Checkout
# return URLs. Must be HTTPS when deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only. Used by the Stripe checkout and webhook routes to write `payments` and activate
# memberships. Locally: SERVICE_ROLE_KEY from `npx supabase status`. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe test mode (https://dashboard.stripe.com/test/apikeys). Optional for everything except payments.
STRIPE_SECRET_KEY=
# From `npm run stripe:listen` locally, or the dashboard webhook endpoint when deployed.
STRIPE_WEBHOOK_SECRET=
